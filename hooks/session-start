#!/usr/bin/env bash
# SessionStart hook for the working-agreements plugin.
# Injects the working-agreements contract into the session context.

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the working-agreements contract, stripping the frontmatter block
bootstrap_content=$(cat "${PLUGIN_ROOT}/skills/working-agreements/SKILL.md" 2>&1 || echo "Error reading working-agreements skill")
bootstrap_content=$(printf '%s\n' "$bootstrap_content" | sed '1,/^---$/d')

# Prefer a real Python interpreter for correct JSON escaping (handles control
# bytes and multibyte sequences); fall back to bash parameter substitution.
if command -v python3 >/dev/null 2>&1; then
    PY="python3"
elif command -v python >/dev/null 2>&1; then
    PY="python"
fi

session_context="<EXTREMELY-IMPORTANT>
You have working agreements to honor.

**Below is the full content of your 'working-agreements' skill - the always-on engineering contract for this project. It is ALREADY LOADED in this session; the stack skills listed inside load on demand.**

${bootstrap_content}
</EXTREMELY-IMPORTANT>"

if [ -n "${PY:-}" ]; then
    # json.dumps returns a complete JSON string literal (surrounding quotes included).
    additional_context=$(printf '%s' "$session_context" | "$PY" -c 'import sys, json; print(json.dumps(sys.stdin.read()))')
else
    # Fallback: minimal escape (\\, ", newline, \r, \t) and explicit quotes.
    # Runs only when no Python interpreter is available.
    escape_for_json() {
        local s="$1"
        s="${s//\\/\\\\}"
        s="${s//\"/\\\"}"
        s="${s//$'\n'/\\n}"
        s="${s//$'\r'/\\r}"
        s="${s//$'\t'/\\t}"
        printf '%s' "$s"
    }
    additional_context="\"$(escape_for_json "$session_context")\""
fi

# Output context injection as JSON.
# Claude Code expects hookSpecificOutput.additionalContext (nested).
# Other platforms may consume additionalContext (top-level).
if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": %s\n  }\n}\n' "$additional_context" | cat
else
  printf '{\n  "additionalContext": %s\n}\n' "$additional_context" | cat
fi

exit 0
